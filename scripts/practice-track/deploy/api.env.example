# JobSeeker practice API on the server. install.sh copies this to /etc/jobseeker/api.env (root:jobseeker, 0640)
# only when that file does not exist yet. Fill every <...> value, then: sudo systemctl restart jobseeker-api
# Never commit the filled file. Guide: docs/practice-track/deploy-azure.md

APP_ENV=production
AUTH_DISABLED=false

# Team Supabase project (Project Settings -> API). New projects sign sessions with JWT signing keys (jwks).
# A project that still uses the legacy JWT secret: SUPABASE_JWT_MODE=hs256 and SUPABASE_JWT_SECRET=<that secret>
SUPABASE_URL=<https://PROJECT-REF.supabase.co>
SUPABASE_JWT_MODE=jwks
SUPABASE_JWT_SECRET=
# Recordings are kept in this private Storage bucket. Project Settings -> API Keys: a secret key (sb_secret_...)
# or the legacy service_role key both work
SUPABASE_SERVICE_ROLE_KEY=<service role key>
STORAGE_BUCKET=recordings

# Connect -> Session pooler (IPv4). The direct db.PROJECT-REF.supabase.co address is IPv6 only on the free plan
DATABASE_URL=<postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres>
# Turn on only after the team applies supabase/migrations/20261104_practice_insights.sql (A2)
PRACTICE_INSIGHTS_ENABLED=false

# The team web app's address (comma separated). Chrome extensions are already allowed by the app
CORS_ORIGINS=<https://TEAM-WEB-ADDRESS>

# Users' day for D-day, due-date sorting and upcoming items (the server clock is UTC)
APP_TIMEZONE=Asia/Seoul

# Speech to text on this server's CPU (nothing is sent out). Loaded at start so it stays in memory
STT_PROVIDER=local
LOCAL_STT_MODEL=base
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8
LOCAL_STT_CPU_THREADS=2
LOCAL_STT_PRELOAD=true

# Follow-up questions from a small local model (EXAONE 4.0 1.2B, non-commercial license). Loaded at start
FOLLOWUP_MODEL=local
FOLLOWUP_THREADS=2
FOLLOWUP_TIMEOUT_SEC=45
FOLLOWUP_PRELOAD=true

# Only when Supabase Storage is not configured above
RECORDINGS_DIR=/var/lib/jobseeker/recordings
AUDIO_RETENTION_DAYS=30
