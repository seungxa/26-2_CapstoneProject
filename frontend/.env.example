# Team-owned Supabase Auth client. Use the project's public/publishable key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Practice/Track FastAPI service; never put backend secrets here.
VITE_API_URL=http://localhost:8000
