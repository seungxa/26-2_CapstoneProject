{
  "manifest_version": 3,
  "name": "JobSeeker Apply",
  "version": "0.7.0",
  "description": "Fill job applications from your saved profile.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "webNavigation"
  ],
  "minimum_chrome_version": "116",
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.incruit.com/*",
    "https://*.saramin.co.kr/*",
    "https://*.jobkorea.co.kr/*"
  ],
  "action": {
    "default_title": "Open JobSeeker"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}