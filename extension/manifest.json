{
  "manifest_version": 3,
  "name": "JobSeeker",
  "version": "0.8.0",
  "description": "Save job postings to your application tracker and fill applications from your saved profile.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "webNavigation"
  ],
  "minimum_chrome_version": "116",
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.incruit.com/*",
    "https://*.saramin.co.kr/*",
    "https://*.jobkorea.co.kr/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://team-api.duckdns.org/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobSeeker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*"
    ]
  }
}
